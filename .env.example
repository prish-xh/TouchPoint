# Server-only. Copy to .env.local; never commit actual keys.
# All /api routes require Authorization: Bearer <this private demo token>.
TOUCHPOINT_DEMO_TOKEN=
PERCEPTRON_API_KEY=
# Confirm model entitlement with the event organizers; public docs use perceptron-mk1.5.
PERCEPTRON_MODEL=perceptron-mk1.5
GEMINI_API_KEY=
# Set an available generateContent model from your account.
GEMINI_MODEL=
BACKBOARD_API_KEY=
# Dedicated single-demo-user assistant and existing preferences memory record.
BACKBOARD_ASSISTANT_ID=
BACKBOARD_PREFERENCES_MEMORY_ID=
